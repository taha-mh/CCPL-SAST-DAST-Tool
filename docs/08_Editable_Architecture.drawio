      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n%% =====================\n%% USER\n%% =====================\n\nA([Start])\n\nA --&gt; B[Select Scan Type]\n\nB --&gt; C[Click \&quot;Start Scan\&quot;]\n\nC --&gt; D[Frontend sends POST /api/scan]\n\n%% =====================\n%% BACKEND\n%% =====================\n\nD --&gt; E[Backend Receives Request]\n\nE --&gt; F[Create Background Scan Job]\n\nF --&gt; G[Generate Unique Scan ID]\n\nG --&gt; H{Scan Type Router}\n\n%% =====================\n%% SCANNERS\n%% =====================\n\nH --&gt;|Web SAST| I[Run Semgrep&lt;br/&gt;Static Source Code Analysis]\n\nH --&gt;|Web DAST| J[Run OWASP ZAP&lt;br/&gt;Dynamic Web Scan]\n\nH --&gt;|Mobile SAST| K[Run JADX&lt;br/&gt;APK Static Analysis]\n\nH --&gt;|Mobile DAST| L[Run MobSF&lt;br/&gt;Dynamic Mobile Analysis]\n\n%% =====================\n%% NORMALIZATION\n%% =====================\n\nI --&gt; M\n\nJ --&gt; M\n\nK --&gt; M\n\nL --&gt; M\n\nM[Parse &amp; Normalize Results&lt;br/&gt;Convert all scanner outputs into a Standard Security JSON Format]\n\n%% =====================\n%% FIRST LLM\n%% =====================\n\nM --&gt; N[LLM #1 (Ollama)&lt;br/&gt;Security Assessment&lt;br/&gt;Analyze Findings&lt;br/&gt;Explain Root Cause&lt;br/&gt;Estimate Severity]\n\n%% =====================\n%% SECOND LLM\n%% =====================\n\nN --&gt; O[LLM #2 (Ollama)&lt;br/&gt;Security Reviewer&lt;br/&gt;Validate Findings&lt;br/&gt;Filter False Positives]\n\n%% =====================\n%% DECISION\n%% =====================\n\nO --&gt; P{Finding Confirmed?}\n\nP --&gt;|Yes| Q[Confirmed Findings]\n\nP --&gt;|No| R[Discarded Findings&lt;br/&gt;Stored for Audit / Appendix]\n\n%% =====================\n%% REPORT\n%% =====================\n\nQ --&gt; S\n\nR --&gt; S\n\nS[Generate Final Security Report&lt;br/&gt;HTML / Markdown / JSON]\n\nS --&gt; T[Store Report]\n\nT --&gt; U[Frontend fetches Report&lt;br/&gt;GET /api/scan-results]\n\nU --&gt; V[Display Report to User]\n\nV --&gt; W([End])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MRXbvlE-8dAX1q8r8nBR-1">
