# Copy these names into your local environment. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=900

# Phase 3 can be pinned independently while still using the shared provider.
MOBILE_OPENAI_MODEL=gpt-5.4-nano
MOBSF_URL=http://127.0.0.1:8001
MOBSF_API_KEY=
